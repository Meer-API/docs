{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Meer API Docs",
  "colors": {
    "primary": "#007fff",
    "light": "#006ad4",
    "dark": "#0079f3"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Quickstart",
            "pages": [
              "guides/quickstart"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "/api-reference/openapi.json",
        "pages": [
          "api-reference/introduction",
          "GET /check_phone_number",
          "api-reference/webhooks",
          "GET /usage_stats",
          "GET /v2/usage_stats",
          "GET /periods"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Get Meer",
          "href": "https://meerapi.com",
          "icon": "user-circle-plus"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@meerapi.com"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {},
  "redirects": [
    {
      "source": "/api-reference/phone-numbers/check-phone-number-against-dnc-registry",
      "destination": "/api-reference/phone-numbers/check-a-phone-number"
    },
    {
      "source": "/api-reference/usage-stats",
      "destination": "/api-reference/usage/get-usage"
    }
  ]
}
